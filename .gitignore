# ITMIS Generated Results
# ------------------------------------------------------------
rechecked.xlsx
rechecked_*.xlsx
rechecked_backup_*.xlsx

summary_*.json

# ------------------------------------------------------------
# Temporary / Exported Data
# ------------------------------------------------------------
*.tmp
*.temp
*.bak
*.backup
*.cache

# Temporary Excel lock files
~$*.xlsx
~$*.xls
~$*.xlsm

# ------------------------------------------------------------
# Local Configuration / Secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example

*.secret
*.secrets
secrets/
credentials/
credentials.json

# Local configuration files
config.local.*
settings.local.*

# ------------------------------------------------------------
# Selenium / Chrome
# ------------------------------------------------------------
chrome_profile/
chrome-data/
selenium/
selenium_cache/
webdriver_cache/

# Chrome crash/debug files
chrome_debug.log
chromedriver.log

# ------------------------------------------------------------
